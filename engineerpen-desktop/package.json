{
  "name": "engineerpen-desktop",
  "productName": "Engineer Pen",
  "version": "1.0.0",
  "private": true,
  "main": "main.js",
  "description": "Engineer Pen - قلم المهندس للكمبيوتر",
  "author": "Mohamed Khalaf",
  "devDependencies": { "electron": "^33.0.0", "electron-builder": "^25.1.8" },
  "build": {
    "appId": "com.mohamed.engineerpen.desktop",
    "productName": "Engineer Pen",
    "files": ["main.js", "app/**/*"],
    "icon": "icon.png",
    "win": { "target": [{ "target": "nsis", "arch": ["x64"] }] },
    "nsis": { "oneClick": true, "perMachine": false, "allowToChangeInstallationDirectory": false, "artifactName": "EngineerPen-Setup.exe", "runAfterFinish": true, "deleteAppDataOnUninstall": false }
  }
}
