{
  "name": "mashari3-desktop",
  "productName": "مراجعة مشاريع",
  "version": "1.0.0",
  "private": true,
  "main": "main.js",
  "description": "مراجعة مشاريع - Project Review",
  "author": "Mohamed Khalaf",
  "devDependencies": { "electron": "^33.0.0", "electron-builder": "^25.1.8" },
  "build": {
    "appId": "com.mohamed.mashari3.desktop",
    "productName": "Mashari3",
    "files": ["main.js", "preload.js", "app/**/*"],
    "icon": "icon.png",
    "win": { "target": [{ "target": "nsis", "arch": ["x64"] }] },
    "nsis": { "oneClick": false, "perMachine": false, "allowToChangeInstallationDirectory": true, "artifactName": "Mashari3-Setup.exe", "runAfterFinish": true, "createDesktopShortcut": true, "shortcutName": "مراجعة مشاريع", "deleteAppDataOnUninstall": false }
  }
}
